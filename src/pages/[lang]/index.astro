---
import SolutionsPage from '../../components/pages/SolutionsPage.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return (['en', 'fr', 'de'] as const).map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: Exclude<Locale, 'es'>; }
const { lang } = Astro.props;
---
<SolutionsPage lang={lang} />
