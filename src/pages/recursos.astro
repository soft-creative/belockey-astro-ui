---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import SectionHeading from '../components/SectionHeading.astro';import IconCard from '../components/IconCard.astro';import CTA from '../components/CTA.astro';
const posts=['Cómo los lockers inteligentes están transformando el sector hotelero','Reserva de taquillas: 5 claves para una experiencia sin fricción','Lockers en retail: más comodidad, más ventas','Gestión de equipaje en ciudades turísticas: una solución para todo el año','Custodia de llaves segura y flexible para gestores de propiedades','Autoservicio: la clave para operaciones más eficientes'];
---
<BaseLayout title="Recursos | BeLockey"><Hero eyebrow="Conocimiento que impulsa tu negocio" title="Recursos para entender, lanzar y optimizar" highlight="tu operación." description="Guías, casos de uso, documentación y contenidos prácticos para sacar el máximo partido a los lockers inteligentes de BeLockey." image="/assets/hero-resources.webp" primary="Explorar recursos" badges={[]} />
<section class="band"><div class="shell"><span class="eyebrow">Explora por tipo de recurso</span><div class="grid grid-6" style="margin-top:16px"><IconCard icon="▤" title="Blog" copy="Artículos, tendencias y buenas prácticas"/><IconCard icon="▧" title="Guías" copy="Recursos en profundidad para tu proyecto"/><IconCard icon="▣" title="Casos de uso" copy="Historias reales de nuestros clientes"/><IconCard icon="?" title="Centro de ayuda" copy="Resuelve tus dudas paso a paso"/><IconCard icon="▤" title="Documentación" copy="Información técnica y para desarrolladores"/><IconCard icon="⇩" title="Descargables" copy="Plantillas, checklists y materiales útiles"/></div></div></section>
<section class="band band-tint" id="destacados"><div class="shell"><SectionHeading eyebrow="Contenidos destacados" title="Recursos imprescindibles para empezar"/><div class="grid grid-3">{[['Guía completa sobre lockers inteligentes para negocios','Todo lo que necesitas saber para planificar, implantar y escalar una solución de lockers en tu negocio.','/assets/resource-feature-1.jpg'],['Cómo Sercotel mejoró la experiencia de sus huéspedes con BeLockey','Descubre cómo una cadena hotelera optimizó la gestión de equipaje y ofreció un servicio 24/7.','/assets/resource-feature-2.jpg'],['Checklist de implantación: de la planificación al lanzamiento','Una lista paso a paso para que tu proyecto de lockers sea un éxito, sin imprevistos.','/assets/resource-feature-3.jpg']].map(([t,c,img])=><article class="card photo-card resource-card"><img src={img} alt=""/><div class="content"><span class="eyebrow">RECURSO</span><h3>{t}</h3><p>{c}</p><span class="text-link">Leer recurso →</span></div></article>)}</div></div></section>
<section class="band"><div class="shell help-search"><div><SectionHeading eyebrow="Centro de ayuda" title="Encuentra respuestas, al instante." copy="Busca en nuestro centro de ayuda o explora por categorías."/><div class="searchbar"><input placeholder="Buscar artículos, guías, preguntas..."/><button class="btn btn-primary">Buscar</button></div></div><div><span class="eyebrow">Categorías destacadas</span><ul class="categories"><li>◌ Primeros pasos</li><li>▣ Gestión de taquillas</li><li>▤ Reservas y pagos</li><li>⌘ Hardware y conectividad</li><li>◌ Integraciones</li><li>♢ Seguridad y permisos</li><li>◎ Configuración de mi cuenta</li><li>⚙ Mantenimiento y soporte</li><li>▱ Facturación</li><li>⌘ API y desarrolladores</li><li>? Preguntas frecuentes</li></ul></div></div></section>
<section class="band band-tint" id="blog"><div class="shell"><SectionHeading eyebrow="Blog" title="Últimos artículos y guías"/><div class="blog-grid">{posts.map((p,i)=><article class="blog-item"><img src={`/assets/blog-${i+1}.jpg`} alt=""/><h3>{p}</h3><span class="tag">{['Operaciones','Producto','Retail','Turismo','Alquiler vacacional','Tendencias'][i]}</span></article>)}</div></div></section>
<section class="band" id="descargables"><div class="shell"><SectionHeading eyebrow="Descargables" title="Recursos listos para usar"/><div class="grid grid-4"><IconCard icon="▤" title="Brochure de producto" copy="Descubre todas las funcionalidades de BeLockey."/><IconCard icon="▥" title="Comparativa de soluciones" copy="Compara BeLockey con otras alternativas del mercado."/><IconCard icon="▧" title="Checklist de implantación" copy="Planifica tu proyecto paso a paso."/><IconCard icon="▣" title="Guía de marca" copy="Recursos de logos, colores y aplicaciones."/></div></div></section>
<section class="band band-tint"><div class="shell split"><div class="card" style="background:#071a4a;color:white"><span class="eyebrow">WEBINAR</span><h2>Cómo lanzar tu operación de lockers en 30 días (sin complicaciones)</h2><p>Una sesión práctica con nuestro equipo de producto.</p><button class="btn btn-outline" type="button">Me interesa →</button></div><div class="card"><div class="icon-bubble">▣</div><h3>¿Prefieres una demo personalizada?</h3><p>Te mostramos cómo BeLockey se adapta a tu negocio en una sesión a medida.</p><button class="btn btn-primary" type="button">Reservar demo →</button></div></div></section>
<section class="band"><div class="shell split"><SectionHeading eyebrow="¿Aún tienes dudas?" title="Estamos aquí para ayudarte." copy="Consulta nuestras preguntas frecuentes, explora la documentación o habla directamente con nuestro equipo."/><div class="grid grid-3"><IconCard icon="◌" title="Ver FAQ" copy="Respuestas rápidas"/><IconCard icon="▤" title="Leer documentación" copy="Guías técnicas"/><IconCard icon="◔" title="Contactar con soporte" copy="Te ayudamos"/></div></div></section><CTA/>
</BaseLayout>
