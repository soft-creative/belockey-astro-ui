---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import SectionHeading from '../components/SectionHeading.astro';import IconCard from '../components/IconCard.astro';import FAQ from '../components/FAQ.astro';import CTA from '../components/CTA.astro';
const cases=[['Click & Collect','La forma más eficiente de entregar pedidos online. Tus clientes recogen sus compras cuando quieran, sin colas ni esperas.','/assets/solution-card-1.jpg'],['Custodia de equipaje','Ofrece a tus usuarios un espacio seguro para su equipaje, con reservas digitales y acceso autónomo.','/assets/solution-card-2.jpg'],['Consignas inteligentes','Solución versátil para todo tipo de objetos. Ideal para espacios públicos, comerciales o de alta afluencia.','/assets/solution-card-3.jpg'],['Custodia de llaves','Gestiona llaves de forma segura y eficiente. Perfecto para alquileres, flotas, empresas de servicios y más.','/assets/solution-card-4.jpg']];
const sectors=[['Retail y e-commerce','Entrega de pedidos online, devoluciones y recogidas sin contacto.','/assets/sector-1.jpg'],['Hoteles y turismo','Custodia de equipaje, check-in autónomo y mejor experiencia del huésped.','/assets/sector-2.jpg'],['Empresas','Gestión de pertenencias, equipos de trabajo y llaves para empleados y visitas.','/assets/sector-3.jpg'],['Transporte','Consignas en estaciones, aeropuertos y terminales para una movilidad más cómoda.','/assets/sector-4.jpg'],['Gimnasios y centros','Taquillas seguras para socios, visitas y personal.','/assets/sector-5.jpg']];
---
<BaseLayout title="Soluciones | BeLockey" description="Soluciones de lockers inteligentes para retail, turismo, empresas y más.">
<Hero eyebrow="Una solución para cada negocio" title="Soluciones para cada" highlight="caso de uso." description="En BeLockey adaptamos el hardware y el software a las necesidades de cada sector y modelo de negocio, para que puedas ofrecer una experiencia de autoservicio segura, flexible y eficiente." image="/assets/hero-solutions.webp" primary="Solicitar demo" badges={['Soluciones a medida de tu negocio','Hardware y software totalmente integrados','Escalable en una o múltiples ubicaciones']} />
<section class="band" id="casos"><div class="shell"><div class="pill-row"><span class="pill active">🛒 Click & Collect</span><span class="pill">▣ Custodia de equipaje</span><span class="pill">⬡ Consignas inteligentes</span><span class="pill">⚿ Custodia de llaves</span><span class="pill">▢ Retail y e-commerce</span><span class="pill">✈ Hoteles y turismo</span><span class="pill">▣ Empresas</span><span class="pill">▤ Transporte</span></div><SectionHeading eyebrow="Soluciones destacadas" title="Casos de uso que transforman tu operación." /><div class="grid grid-4">{cases.map(([t,c,img])=><article class="card photo-card"><img src={img} alt=""/><div class="content"><h3>{t}</h3><p>{c}</p><span class="text-link">Saber más →</span></div></article>)}</div></div></section>
<section class="band" id="sectores"><div class="shell"><SectionHeading eyebrow="Soluciones por sector" title="Tu sector, nuestra tecnología." copy="Cada sector tiene sus propios retos. En BeLockey te ofrecemos soluciones adaptadas para que saques el máximo partido a tus taquillas inteligentes." /><div class="grid grid-5">{sectors.map(([t,c,img])=><article class="card photo-card"><img src={img} alt=""/><div class="content"><h3>{t}</h3><p>{c}</p><span class="text-link">Ver solución →</span></div></article>)}</div></div></section>
<section class="band band-tint" id="implementacion"><div class="shell"><SectionHeading eyebrow="Diferentes formas de implementación" title="Una solución, múltiples formas de funcionar."/><div class="grid grid-4"><IconCard icon="▣" title="Reservas online" copy="Tus usuarios reservan y pagan desde el móvil."/><IconCard icon="⌂" title="Autoservicio en el local" copy="Acceso rápido y sencillo con códigos, QR o tarjeta."/><IconCard icon="▤" title="Control remoto" copy="Gestiona todo desde una única plataforma, estés donde estés."/><IconCard icon="⌘" title="Multiubicación" copy="Escala tu solución a una o múltiples ubicaciones fácilmente."/></div></div></section>
<section class="band"><div class="shell"><SectionHeading eyebrow="Todo lo que necesitas" title="Qué incluye cada solución."/><div class="grid grid-5"><IconCard icon="▤" title="Software de gestión" copy="Panel web, app y herramientas de control."/><IconCard icon="▥" title="Hardware inteligente" copy="Taquillas modulares, interior y exterior."/><IconCard icon="▱" title="Pagos y facturación" copy="Múltiples métodos de pago e integración."/><IconCard icon="♙" title="Permisos y usuarios" copy="Control de accesos, roles y auditoría."/><IconCard icon="◔" title="Soporte y acompañamiento" copy="Te ayudamos en todo el proceso."/></div></div></section>
<section class="band band-tint"><div class="shell"><SectionHeading eyebrow="Guía de decisión" title="Encuentra tu solución ideal."/><div class="table-wrap"><table><thead><tr><th>Solución</th><th>¿Qué resuelve?</th><th>Ubicación habitual</th><th>Modelo operativo</th><th>Ideal para...</th></tr></thead><tbody><tr><td><b>Click & Collect</b></td><td>Entrega y recogida de pedidos</td><td>Tiendas, centros comerciales</td><td>Autónomo / 24/7</td><td>Retail y e-commerce</td></tr><tr><td><b>Custodia de equipaje</b></td><td>Guarda de maletas y pertenencias</td><td>Hoteles, estaciones, aeropuertos</td><td>Con reserva / Autónomo</td><td>Turismo y transporte</td></tr><tr><td><b>Consignas inteligentes</b></td><td>Custodia de objetos</td><td>Espacios públicos, centros</td><td>Autónomo / 24/7</td><td>Uso general</td></tr><tr><td><b>Custodia de llaves</b></td><td>Gestión segura de llaves</td><td>Empresas, alquileres, servicios</td><td>Con permisos</td><td>Empresas y servicios</td></tr></tbody></table></div></div></section>
<FAQ title="Dudas comunes sobre nuestras soluciones." items={['¿Cuánto tiempo se tarda en implementar una solución?','¿Puedo personalizar el tamaño y número de taquillas?','¿Qué métodos de pago están disponibles?','¿Ofrecéis soporte técnico tras la instalación?']}/><CTA title="¿Hablamos de tu proyecto?" copy="Cuéntanos tu caso y te ayudaremos a encontrar la mejor solución." />
</BaseLayout>
