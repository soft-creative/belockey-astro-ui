---
import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import SectionHeading from '../components/SectionHeading.astro';import IconCard from '../components/IconCard.astro';import FAQ from '../components/FAQ.astro';import CTA from '../components/CTA.astro';
---
<BaseLayout title="Sobre nosotros | BeLockey"><Hero eyebrow="Espacios más inteligentes, negocios más libres" title="Tecnología para simplificar negocios basados en" highlight="lockers inteligentes." description="En BeLockey desarrollamos la tecnología y el ecosistema que permite a cualquier negocio operar lockers inteligentes de forma simple, segura y rentable." image="/assets/hero-about.webp" badges={[]} />
<section class="band"><div class="shell split"><div><SectionHeading eyebrow="Una plataforma integral" title="Qué es BeLockey" copy="BeLockey es una plataforma todo en uno que combina hardware, software y automatización para que puedas lanzar, gestionar y hacer crecer tu negocio de consignas urbanas o lockers inteligentes, sin complicaciones."/></div><div class="grid grid-3"><IconCard icon="⬡" title="Hardware inteligente" copy="Taquillas, kioscos y dispositivos diseñados para un uso intensivo, seguro y versátil."/><IconCard icon="▤" title="Software en la nube" copy="Gestión total, reservas, pagos, control remoto y analítica en tiempo real."/><IconCard icon="⚙" title="Automatización" copy="Procesos simples para que tú te centres en hacer crecer tu negocio."/></div></div></section>
<section class="band band-tint" id="principios"><div class="shell"><SectionHeading eyebrow="Nuestros principios" title="Lo que nos guía"/><div class="grid grid-6"><IconCard icon="⚡" title="Simplicidad" copy="Tecnología potente, fácil de usar."/><IconCard icon="♢" title="Fiabilidad" copy="Siempre disponible cuando lo necesitas."/><IconCard icon="▣" title="Seguridad" copy="La confianza es la base de todo."/><IconCard icon="▥" title="Escalabilidad" copy="Crecemos contigo, sin límites."/><IconCard icon="♡" title="Diseño útil" copy="Pensada para la vida real."/><IconCard icon="♙" title="Soporte cercano" copy="Te acompañamos en cada paso."/></div></div></section>
<section class="band" id="proceso"><div class="shell split"><div><SectionHeading eyebrow="Así trabajamos" title="De la idea al impacto" copy="Acompañamos a nuestros clientes en todo el proceso, con un enfoque práctico, transparente y orientado a resultados."/></div><div class="process">{['Análisis','Configuración','Implementación','Operación','Crecimiento'].map((s,i)=><div class="process-item"><div class="step">{i+1}</div><strong>{s}</strong><p>{['Entendemos tus necesidades y objetivos.','Diseñamos la solución ideal para tu negocio.','Instalación y puesta en marcha sin complicaciones.','Te acompañamos en el día a día.','Nuevas ubicaciones, más oportunidades.'][i]}</p></div>)}</div></div></section>
<section class="band band-tint"><div class="shell split"><div><SectionHeading eyebrow="Un ecosistema completo" title="Todo lo que necesitas, conectado" copy="Hardware, software, pagos, control de accesos, analítica y más. Un ecosistema diseñado para que operes con total tranquilidad."/><a class="btn btn-primary" href="/producto">Conoce nuestro producto →</a></div><div class="grid grid-4"><IconCard icon="▥" title="Taquillas inteligentes" copy="Interior y exterior, para cualquier necesidad."/><IconCard icon="▣" title="Kioscos y pantallas" copy="Reserva, pago y acceso en un solo dispositivo."/><IconCard icon="▤" title="Software de gestión" copy="Control total desde la nube, en tiempo real."/><IconCard icon="▯" title="App para usuarios" copy="Una experiencia simple y sin fricciones."/></div></div></section>
<section class="band"><div class="shell"><SectionHeading eyebrow="Para diversos sectores" title="Para quién trabajamos"/><div class="grid grid-6"><IconCard icon="▢" title="Retail" copy="Centros comerciales, tiendas, outlets."/><IconCard icon="✈" title="Transporte" copy="Aeropuertos, estaciones, intercambiadores."/><IconCard icon="▥" title="Hospitality" copy="Hoteles, alojamientos, apartamentos turísticos."/><IconCard icon="⌁" title="Deporte y ocio" copy="Gimnasios, eventos, recintos deportivos."/><IconCard icon="▦" title="Empresas" copy="Oficinas, coworkings, entornos corporativos."/><IconCard icon="•••" title="Más sectores" copy="Soluciones flexibles para nuevos usos."/></div></div></section>
<section class="band band-tint" id="vision"><div class="shell split"><div><SectionHeading eyebrow="Por qué existimos" title="Un futuro más abierto y conectado" copy="Creemos en ciudades y espacios más libres, donde las personas puedan moverse, disfrutar y aprovechar nuevas oportunidades sin barreras. BeLockey existe para hacer posible una forma más simple, segura y eficiente de gestionar pertenencias en un mundo en constante movimiento."/></div><div class="image-panel"><img src="/assets/vision.jpg" alt="Espacio urbano contemporáneo"/></div></div></section>
<FAQ title="Tus dudas, resueltas" items={['¿Qué incluye la plataforma de BeLockey?','¿Necesito conocimientos técnicos para empezar?','¿Puedo integrar BeLockey con otros sistemas?','¿Ofrecéis soporte tras la implantación?']}/><CTA title="¿Listo para impulsar tu proyecto con lockers inteligentes?" />
</BaseLayout>
