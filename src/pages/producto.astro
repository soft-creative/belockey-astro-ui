---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LockerVisual from '../components/LockerVisual.astro';
---
<BaseLayout title="Producto · BeLockey" description="Plataforma BeLockey para gestión de lockers inteligentes.">
  <Header active="producto" />
<section class="hero" id="vision"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">Producto BeLockey</div><h1>Una plataforma para <span class="blue">gestionar lockers</span> de principio a fin.</h1><p>Centraliza reservas, taquillas, ubicaciones, usuarios, pagos y el estado de la operativa desde un único panel. Conecta la experiencia del cliente con la gestión diaria del negocio.</p><div class="actions"><a class="btn primary" href="/contacto#formulario">Solicitar demo →</a><a class="btn secondary" href="#operaciones">Ver cómo funciona</a></div><div class="hero-note"><span><i class="tick"></i> Gestión centralizada</span><span><i class="tick"></i> Acceso seguro</span><span><i class="tick"></i> Operación remota</span></div></div><LockerVisual /></div></section><div class="strip"><div class="container strip-grid"><div class="mini"><span class="icon">▦</span>Reservas online</div><div class="mini"><span class="icon">▣</span>Kiosco autoservicio</div><div class="mini"><span class="icon">⌁</span>Gestión remota</div><div class="mini"><span class="icon">◫</span>Pagos integrados</div><div class="mini"><span class="icon">◎</span>Monitorización</div></div></div><section class="section" id="marca"><div class="container"><div class="section-head"><div><div class="eyebrow">Tu marca por delante</div><h2>Una experiencia coherente para tus clientes.</h2></div><p>Personaliza la experiencia visible del servicio para que la reserva, el kiosco y las comunicaciones encajen con la identidad de tu negocio.</p></div><div class="grid2"><div><div class="grid2"><div class="card"><div class="icon">◐</div><h3>Identidad visual</h3><p>Logo, colores y elementos visuales aplicados a los puntos de contacto.</p></div><div class="card"><div class="icon">◫</div><h3>Web de reservas</h3><p>Reserva online adaptada a la experiencia de tu negocio y tus ubicaciones.</p></div><div class="card"><div class="icon">▣</div><h3>Kiosco en el local</h3><p>Autoservicio para que el cliente pueda reservar y acceder desde la ubicación.</p></div><div class="card"><div class="icon">✉</div><h3>Comunicaciones</h3><p>Flujos y mensajes vinculados a la reserva y al acceso.</p></div></div></div><div class="brand-panel"><div class="eyebrow">Configuración</div><h3>Una misma identidad en todos los canales</h3><div class="row"><b>Colores de marca</b><div class="swatches"><i></i><i></i><i></i></div></div><div class="row"><b>Reserva online</b><div class="toggle"></div></div><div class="row"><b>Kiosco</b><div class="toggle"></div></div><div class="row"><b>Pagos</b><div class="toggle"></div></div></div></div></div></section><section class="section soft" id="operaciones"><div class="container"><div class="section-head"><div><div class="eyebrow">Consola de operaciones</div><h2>Toda tu operativa, <span class="blue">en una pantalla.</span></h2></div><p>Consulta y gestiona la actividad de tus ubicaciones desde una plataforma pensada para la operación diaria.</p></div><div class="grid3"><div class="card"><div class="icon">▥</div><h3>Reservas</h3><div class="bullets"><div><span class="check">✓</span>Reservas actuales y futuras</div><div><span class="check">✓</span>Estados y seguimiento</div><div><span class="check">✓</span>Gestión desde el panel</div></div></div><div class="card"><div class="icon">▦</div><h3>Taquillas y ubicaciones</h3><div class="bullets"><div><span class="check">✓</span>Estado de taquillas</div><div><span class="check">✓</span>Múltiples ubicaciones</div><div><span class="check">✓</span>Configuración centralizada</div></div></div><div class="card"><div class="icon">◎</div><h3>Monitorización</h3><div class="bullets"><div><span class="check">✓</span>Estado de conexión</div><div><span class="check">✓</span>Actividad reciente</div><div><span class="check">✓</span>Control remoto</div></div></div></div></div></section><section class="section" id="integraciones"><div class="container"><div class="section-head"><div><div class="eyebrow">Pagos e integraciones</div><h2>Conecta la operativa con tus herramientas.</h2></div><p>BeLockey integra los pagos dentro del flujo de reserva y permite conectar la plataforma con servicios externos.</p></div><div class="grid3"><div class="card"><div class="icon">S</div><h3>Stripe</h3><p>Integración de pago dentro del proceso de reserva.</p></div><div class="card"><div class="icon">P</div><h3>PayPal</h3><p>Opción de pago integrada en la operativa.</p></div><div class="card"><div class="icon">M</div><h3>myPOS</h3><p>Integración con el ecosistema de pagos utilizado por el negocio.</p></div></div></div></section><section class="section soft" id="faq"><div class="container"><div class="section-head"><div><div class="eyebrow">FAQ</div><h2>Preguntas sobre el producto.</h2></div></div><div class="faq"><div class="item"><span>¿Puedo gestionar varias ubicaciones?</span><span>+</span></div><div class="item"><span>¿Los clientes pueden reservar online?</span><span>+</span></div><div class="item"><span>¿Puedo utilizar un kiosco en el local?</span><span>+</span></div><div class="item"><span>¿Cómo se monitoriza el estado de un kiosco?</span><span>+</span></div></div></div></section><section class="section compact"><div class="container"><div class="callout"><div><div class="eyebrow">Conoce BeLockey</div><h2>¿Quieres verlo funcionando en tu negocio?</h2><p>Solicita una demo y revisamos contigo el flujo que necesitas.</p></div><a class="btn primary" href="/contacto#formulario">Solicitar demo →</a></div></div></section>
  <Footer />
</BaseLayout>
