const sections = ["1. Quiénes somos", "2. Qué recogemos, y por qué", "3. Bases jurídicas bajo el RGPD", "4. Dónde se guarda", "5. Cuánto tiempo lo conservamos", "6. Tus derechos", "7. Compartición con terceros", "8. Menores", "9. Cambios en esta política", "10. Contacto"];
