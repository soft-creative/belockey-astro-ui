---
const {title='¿Listo para llevar tu negocio al siguiente nivel?',copy='Descubre cómo BeLockey puede ayudarte. Reserva una demo y te lo mostramos sin compromiso.'}=Astro.props;
---
<section class="shell cta" id="demo">
  <div>
    <span class="eyebrow">TU OPERACIÓN, UN PASO MÁS SIMPLE</span>
    <h2>{title}</h2>
    <p>{copy}</p>
  </div>
  <div class="actions">
    <button class="btn btn-primary" type="button">Reservar demo →</button>
    <button class="btn btn-outline" type="button">Hablar con una persona</button>
  </div>
</section>
