---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { translations, type Locale } from '../../i18n';
import { contactFormMessages, contactTopics } from '../../i18n/contact-form';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang].contact;
const formMessages = contactFormMessages[lang];
const cardIcons = ['▦', '◫', '▶'];
---
<BaseLayout title={t.metaTitle} description={t.metaDescription} lang={lang} page="contact">
  <Header active="contacto" lang={lang} page="contact" />
  <main>
    <section class="legal-hero"><div class="container"><div class="eyebrow">{t.hero.eyebrow}</div><h1 class="contact-title">{t.hero.before} <span class="blue">{t.hero.highlight}</span></h1><p class="lead contact-lead">{t.hero.copy}</p></div></section>
    <section class="section" id="formulario">
      <div class="container"><div class="form-grid">
        <form class="card contact-form" action="/api/contact" method="post" data-messages={JSON.stringify(formMessages)}>
          <h2 class="contact-form-title">{t.form.title}</h2>
          <p>{t.form.copy}</p>
          <input type="hidden" name="lang" value={lang} />
          <div class="contact-honeypot" aria-hidden="true" inert>
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="grid2 contact-fields">
            <div>
              <label class="field-label" for="contact-name">{t.form.name}</label>
              <input class="input" id="contact-name" name="name" autocomplete="name" placeholder={t.form.namePlaceholder} maxlength="100" required />
            </div>
            <div>
              <label class="field-label" for="contact-email">{t.form.email}</label>
              <input class="input" id="contact-email" name="email" type="email" autocomplete="email" placeholder="your@email.com" maxlength="254" required />
            </div>
            <div>
              <label class="field-label" for="contact-company">{t.form.company}</label>
              <input class="input" id="contact-company" name="company" autocomplete="organization" placeholder={t.form.companyPlaceholder} maxlength="200" />
            </div>
            <div>
              <label class="field-label" for="contact-topic">{t.form.topic}</label>
              <select class="select" id="contact-topic" name="topic" required>
                <option value="" disabled selected>{t.form.topicPlaceholder.replace(' ▾', '')}</option>
                {contactTopics.map((value, index) => <option value={value}>{formMessages.topics[index]}</option>)}
              </select>
            </div>
          </div>
          <div class="contact-message">
            <label class="field-label" for="contact-message">{t.form.message}</label>
            <textarea class="textarea" id="contact-message" name="message" placeholder={t.form.messagePlaceholder} maxlength="5000" rows="6" required></textarea>
          </div>
          <p class="contact-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
          <div class="actions contact-submit"><button class="btn primary" type="submit">{t.form.send}</button></div>
        </form>
        <aside class="contact-side"><div class="eyebrow">{t.aside.eyebrow}</div><h3>{t.aside.title}</h3><div class="bullets">{t.aside.items.map((item) => <div><span class="check">✓</span>{item}</div>)}</div><hr/><p>{t.aside.note}</p></aside>
      </div></div>
    </section>
    <section class="section soft"><div class="container"><div class="grid3">{t.cards.map(([title, copy], index) => <div class="card"><div class="icon">{cardIcons[index]}</div><h3>{title}</h3><p>{copy}</p></div>)}</div></div></section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLParagraphElement>('.contact-status')!;
    const messages = JSON.parse(form.dataset.messages!);
    const buttonLabel = button.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled || !form.reportValidity()) return;
      button.disabled = true;
      button.textContent = messages.sending;
      form.setAttribute('aria-busy', 'true');
      status.textContent = '';
      status.removeAttribute('data-state');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
          signal: AbortSignal.timeout(25_000)
        });
        const result = await response.json();
        if (response.ok && result.ok === true && result.code === 'success') {
          form.reset();
          status.textContent = messages.success;
          status.dataset.state = 'success';
        } else {
          status.textContent = result.code === 'invalid' ? messages.invalid : result.code === 'limited' ? messages.limited : messages.error;
          status.dataset.state = 'error';
        }
      } catch {
        status.textContent = messages.error;
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.textContent = buttonLabel;
        form.removeAttribute('aria-busy');
        status.focus({ preventScroll: true });
      }
    });
  }
</script>
