---
import { paths, translations, type Locale } from '../i18n';
interface Props { lang?: Locale; }
const { lang = 'es' } = Astro.props;
const t = translations[lang].common;
const productAnchors = ['#vision', '#marca', '#operaciones', '#integraciones', '#faq'];
const solutionAnchors = ['#casos', '#sectores', '#implementacion', '#guia'];
const pricingAnchors = ['#composicion', '#factores', '#contratacion', '#faq'];
---
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="foot-brand">
        <a class="brand-logo" href={paths[lang].solutions} aria-label="BeLockey"><img src="/assets/belockey-logo.png" alt="BeLockey" /></a>
        <p>{t.footer.description}</p>
      </div>
      <div>
        <div class="footer-title">{t.nav.solutions}</div>
        <div class="footer-links">
          {t.footer.solutionLinks.map((label, index) => <a href={`${paths[lang].solutions}${solutionAnchors[index]}`}>{label}</a>)}
        </div>
      </div>
      <div>
        <div class="footer-title">{t.nav.product}</div>
        <div class="footer-links">
          {t.footer.productLinks.map((label, index) => <a href={`${paths[lang].product}${productAnchors[index]}`}>{label}</a>)}
        </div>
      </div>
      <div>
        <div class="footer-title">{t.nav.pricing}</div>
        <div class="footer-links">
          {t.footer.pricingLinks.map((label, index) => <a href={`${paths[lang].pricing}${pricingAnchors[index]}`}>{label}</a>)}
        </div>
      </div>
      <div>
        <div class="footer-title">{t.footer.about}</div>
        <div class="footer-links">
          <a href={paths[lang].contact}>{t.nav.contact}</a>
          <a href={paths[lang].privacy}>{t.footer.privacy}</a>
          <a href={paths[lang].terms}>{t.footer.terms}</a>
          <a href={paths[lang].cookies}>{t.footer.cookies}</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom"><span>© 2026 BeLockey</span><span>{t.footer.signature}</span></div>
  </div>
</footer>
