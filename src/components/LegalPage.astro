---
interface Props {
  title: string;
  intro: string;
  sections: string[];
}
const { title, intro, sections } = Astro.props;
---
<section class="legal-hero">
  <div class="container">
    <div class="eyebrow">Legal</div>
    <h1 style="font-size:54px">{title}</h1>
    <p class="lead" style="margin-top:18px">{intro}</p>
  </div>
</section>
<main class="legal-wrap">
  <div class="legal-note">Mock visual: mantener aquí el texto legal aprobado vigente. No se añade contenido jurídico nuevo que no aparezca en las fuentes de BeLockey.</div>
  {sections.map((section) => (
    <>
      <h2>{section}</h2>
      <div class="legal-placeholder"><i></i><i></i><i></i></div>
    </>
  ))}
</main>
