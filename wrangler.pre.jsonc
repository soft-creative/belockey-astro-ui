{
  "name": "belockey-corporate-pre",
  "compatibility_date": "2026-06-23",
  "main": "worker/index.ts",
  "vars": { "CONTACT_TO_EMAIL": "contacta@belockey.com" },
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
